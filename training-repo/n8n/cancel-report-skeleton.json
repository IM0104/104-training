{
  "name": "練習2-退單巡檢日報-骨架",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "days", "daysInterval": 1, "triggerAtHour": 9 }]
        }
      },
      "id": "sched-1",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5150/api/orders/search",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"text\": \"過去 30 天取消的訂單\"}",
        "options": {}
      },
      "id": "http-1",
      "name": "查詢取消訂單",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 300],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Always Output Data 在空結果時會給一個空 item,先濾掉再算筆數\nconst orders = $input\n  .all()\n  .map((i) => i.json)\n  .filter((o) => o.id !== undefined);\nreturn [{ json: { count: orders.length, orders } }];"
      },
      "id": "code-1",
      "name": "整理筆數",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=以下是近 30 天取消訂單的查詢結果 JSON(count 為筆數):{{ JSON.stringify($json) }}",
        "options": {
          "systemMessage": "你是 OrderHub 的退單巡檢助理。只根據提供的資料寫中文日報,不要編造數字。第一行用一句話摘要(會當 issue 標題),其後列出:總筆數、總金額、值得注意的訂單(高金額或高等級會員)。count 為 0 時只回『本日無退單』。"
        }
      },
      "id": "agent-1",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [880, 300]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "gemini-1",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [880, 520],
      "notesInFlow": true,
      "notes": "請在 n8n UI 建立 Google Gemini credential（貼活動 3 的 API key），並選模型 gemini-2.0-flash 或 gemini-2.5-flash（介面有的最新 flash）。"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $('整理筆數').first().json.count }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-1",
      "name": "IF 有退單",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "t1",
              "name": "note",
              "value": "={{ $json.output || '有退單：請接 GitHub Issue 節點（稍後設定 token）' }}",
              "type": "string"
            },
            {
              "id": "t2",
              "name": "count",
              "value": "={{ $('整理筆數').first().json.count }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "true-placeholder",
      "name": "有退單-暫存輸出",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1360, 200],
      "notesInFlow": true,
      "notes": "之後在此改接 GitHub Create Issue + 通知 Webhook"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f1",
              "name": "date",
              "value": "={{ $now.toFormat('yyyy-MM-dd') }}",
              "type": "string"
            },
            {
              "id": "f2",
              "name": "note",
              "value": "本日無退單",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "false-placeholder",
      "name": "無退單-歸檔欄位",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1360, 420],
      "notesInFlow": true,
      "notes": "之後改接 Data Table Insert（表名：巡檢紀錄）"
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [[{ "node": "查詢取消訂單", "type": "main", "index": 0 }]]
    },
    "查詢取消訂單": {
      "main": [[{ "node": "整理筆數", "type": "main", "index": 0 }]]
    },
    "整理筆數": {
      "main": [[{ "node": "AI Agent", "type": "main", "index": 0 }]]
    },
    "Google Gemini Chat Model": {
      "ai_languageModel": [[{ "node": "AI Agent", "type": "ai_languageModel", "index": 0 }]]
    },
    "AI Agent": {
      "main": [[{ "node": "IF 有退單", "type": "main", "index": 0 }]]
    },
    "IF 有退單": {
      "main": [
        [{ "node": "有退單-暫存輸出", "type": "main", "index": 0 }],
        [{ "node": "無退單-歸檔欄位", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
