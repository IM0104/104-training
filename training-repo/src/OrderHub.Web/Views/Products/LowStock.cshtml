@model LowStockViewModel
@{
    ViewData["Title"] = "低庫存警示";
}

<h1 class="h3 mb-3">低庫存警示</h1>

<form method="get" asp-action="LowStock" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label asp-for="Threshold" class="form-label"></label>
        <input asp-for="Threshold" class="form-control" type="number" min="1" />
        <span asp-validation-for="Threshold" class="text-danger"></span>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">查詢</button>
    </div>
</form>

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
}
else if (Model.Products.Count == 0)
{
    <div class="alert alert-info">目前沒有庫存低於 @Model.Threshold 的在售商品。</div>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>SKU</th>
                <th>名稱</th>
                <th class="text-end">現有庫存</th>
                <th class="text-end">近 30 天售出數量</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model.Products)
            {
                var rowClass = product.StockQuantity < 5 ? "table-danger" : "";
                <tr class="@rowClass">
                    <td>@product.Sku</td>
                    <td>@product.Name</td>
                    <td class="text-end">@product.StockQuantity</td>
                    <td class="text-end">@product.SoldLast30Days</td>
                </tr>
            }
        </tbody>
    </table>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
